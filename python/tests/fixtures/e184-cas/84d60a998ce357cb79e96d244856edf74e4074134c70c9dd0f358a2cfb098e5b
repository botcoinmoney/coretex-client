"""doc.tool.v1 pack: SENTENCE-LEVEL query-relevance selection over the ranked stream.

Measured on fresh instances the reference loses ~38% of gold support groups at m6: the gold item is
in the ~60-item ranked stream (median position 7) but the strict-prefix pack serves the top ~3 by
entity rank without reading the query. Envelopes are multi-sentence, and a fact is one sentence
surrounded by filler that names unrelated entities -- so this hook scores each item by its BEST
SENTENCE: IDF-weighted overlap with the query's lightly-stemmed terms (document frequency from a
free scan of live events; rare terms such as entity names dominate), plus a small credit for the
rest of the item. Multi-hop: the rare terms of a kept item's best sentence join the query so the
bridged entity's fact can be found. Tool-origin steps that only report a pending state ("queued",
"result to follow", "not yet", "awaiting", "deferred") are discounted. A diversity discount keeps a
second hop from being crowded out; near-duplicates (Jaccard >= 0.8) collapse; items with no query
overlap are never served. Pure Python -- no metered capability is invoked.
"""
import math
import re
from collections import Counter

from coretex_memory import abi2
from coretex_memory.hooks import HookDispatch

_WORD = re.compile(r"[a-z0-9]+")
_SENT = re.compile(r"(?<=[.!?])\s+")
_STOP = frozenset(("a", "an", "and", "are", "as", "at", "be", "by", "did", "do", "does", "for",
                   "from", "had", "has", "have", "how", "in", "is", "it", "its", "of", "on", "or",
                   "that", "the", "this", "to", "was", "were", "what", "when", "where", "which",
                   "who", "whose", "will", "with"))
_NONFINAL = ("queued", "to follow", "not yet", "awaiting", "deferred", "pending")
_TOOL_ORIGINS = ("tool_call", "tool_result")
DUP_JACCARD = 0.8
ANSWER_BONUS = 1.0
COVERED_DISCOUNT = 0.35
REST_CREDIT = 0.25
NONFINAL_FACTOR = 0.5
HOP_WEIGHT = 0.8
RARE_MAX_DF = 2


def _stem(tok):
    if len(tok) > 4 and not tok.isdigit():
        for suf in ("ing", "ed", "es", "s"):
            if tok.endswith(suf) and len(tok) - len(suf) >= 3:
                tok = tok[:-len(suf)]
                break
        if len(tok) > 4 and tok.endswith("e"):
            tok = tok[:-1]
        if len(tok) > 3 and tok[-1] == tok[-2]:
            tok = tok[:-1]
    return tok


def _toks(text):
    return {_stem(t) for t in _WORD.findall(str(text).casefold()) if t not in _STOP}


def _jaccard(a, b):
    u = len(a | b)
    return (len(a & b) / u) if u else 0.0


def _event_text(ev):
    val = ev.value if hasattr(ev, "value") else None
    return str(val) if val is not None else ""


def _origin(ev):
    ext = ev.extensions or {}
    dm = ext.get("doc_metadata") or {}
    env = dm.get("envelope") or {}
    return str(env.get("origin") or "")


def make_hooks(context):
    store = context.store
    cache = {"n": -1, "df": None, "N": 0}

    def _df():
        n = store.count_events()
        if cache["n"] != n:
            df = Counter()
            count = 0
            for ev in store.live_events():
                df.update(_toks(_event_text(ev)))
                count += 1
            cache["n"], cache["df"], cache["N"] = n, df, count
        return cache["df"], cache["N"]

    def m6_pack(question, merged):
        budget = int(question["budget"])
        qt = _toks(question.get("text") or "")
        df, total = _df()

        def _idf(t):
            return math.log((total + 1.0) / (df.get(t, 0) + 1.0)) + 1.0

        idf = {t: _idf(t) for t in qt}

        # per item: sentences -> (tokens, overlap, rare, nonfinal) ; keep items with any overlap
        scored = []
        for pos, pair in enumerate(merged):
            ev = pair[1]
            text = _event_text(ev)
            toks = _toks(text)
            if not (qt & toks):
                continue
            tool = _origin(ev) in _TOOL_ORIGINS
            sents = []
            for s in _SENT.split(text):
                st = _toks(s)
                ov = qt & st
                rare = {t for t in st if t not in qt and not t.isdigit() and len(t) >= 4
                        and df.get(t, 0) <= RARE_MAX_DF}
                nonfinal = tool and any(p in s.casefold() for p in _NONFINAL)
                sents.append((st, ov, rare, nonfinal))
            scored.append([sents, toks, pos, ev])

        kept, seen, covered, used = [], [], set(), 0
        hop = {}

        def _value(entry):
            sents, toks, pos, ev = entry
            best_s, best_v, total_v = None, -1.0, 0.0
            for st, ov, rare, nonfinal in sents:
                v = sum(idf[t] * (COVERED_DISCOUNT if t in covered else 1.0) for t in ov)
                v += sum(hop[t] for t in st if t in hop)
                if rare and ov:
                    v += ANSWER_BONUS
                if nonfinal:
                    v *= NONFINAL_FACTOR
                total_v += v
                if v > best_v:
                    best_s, best_v = (st, ov, rare, nonfinal), v
            return best_v + REST_CREDIT * (total_v - best_v), best_s

        while scored:
            best, best_val, best_sent = None, -1.0, None
            for entry in scored:
                val, sent = _value(entry)
                if val > best_val or (val == best_val and best is not None and entry[2] < best[2]):
                    best, best_val, best_sent = entry, val, sent
            scored.remove(best)
            sents, toks, pos, ev = best
            if any(_jaccard(toks, s) >= DUP_JACCARD for s in seen):
                continue
            units = context.event_units(ev)
            if used + units > budget:
                continue
            kept.append(context.item_dict(ev, units))
            seen.append(toks)
            if best_sent is not None:
                covered |= best_sent[1]
                for t in best_sent[2]:               # multi-hop: bridge terms from the matched sentence
                    if t not in hop:
                        hop[t] = HOP_WEIGHT * _idf(t)
            used += units
        return kept

    dispatch = HookDispatch()
    dispatch.set_override(abi2.M6, m6_pack)
    return dispatch