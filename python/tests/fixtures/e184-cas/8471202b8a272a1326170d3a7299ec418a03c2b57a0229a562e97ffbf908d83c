ed\",\n\"result to follow\", \"not yet\", \"awaiting\", \"deferred\") are discounted. A diversity discount keeps a\nsecond hop from being crowded out; near-duplicates (Jaccard >= 0.8) collapse; items with no query\noverlap are never served. Pure Python -- no metered capability is invoked.\n\"\"\"\nimport math\nimport re\nfrom collections import Counter\n\nfrom coretex_memory import abi2\nfrom coretex_memory.hooks import HookDispatch\n\n_WORD = re.compile(r\"[a-z0-9]+\")\n_SENT = re.compile(r\"(?<=[.!?])\\s+\")\n_STOP = frozenset((\"a\", \"an\", \"and\", \"are\", \"as\", \"at\", \"be\", \"by\", \"did\", \"do\", \"does\", \"for\",\n                   \"from\", \"had\", \"has\", \"have\", \"how\", \"in\", \"is\", \"it\", \"its\", \"of\", \"on\", \"or\",\n                   \"that\", \"the\", \"this\", \"to\", \"was\", \"were\", \"what\", \"when\", \"where\", \"which\",\n                   \"who\", \"whose\", \"will\", \"with\"))\n_NONFINAL = (\"queued\", \"to follow\", \"not yet\", \"awaiting\", \"deferred\", \"pending\")\n_TOOL_ORIGINS = (\"tool_call\", \"tool_result\")\nDUP_JACCARD = 0.8\nANSWER_BONUS = 1.0\nCOVERED_DISCOUNT = 0.35\nREST_CREDIT = 0.25\nNONFINAL_FACTOR = 0.5\nHOP_WEIGHT = 0.8\nRARE_MAX_DF = 2\n\n\ndef _stem(tok):\n    if len(tok) > 4 and not tok.isdigit():\n        for suf in (\"ing\", \"ed\", \"es\", \"s\"):\n            if tok.endswith(suf) and len(tok) - len(suf) >= 3:\n                tok = tok[:-len(suf)]\n                break\n        if len(tok) > 4 and tok.endswith(\"e\"):\n            tok = tok[:-1]\n        if len(tok) > 3 and tok[-1] == tok[-2]:\n            tok = tok[:-1]\n    return tok\n\n\ndef _toks(text):\n    return {_stem(t) for t in _WORD.findall(str(text).casefold()) if t not in _STOP}\n\n\ndef _jaccard(a, b):\n    u = len(a | b)\n    return (len(a & b) / u) if u else 0.0\n\n\ndef _event_text(ev):\n    val = ev.value if hasattr(ev, \"value\") else None\n    return str(val) if val is not None else \"\"\n\n\ndef _origin(ev):\n    ext = ev.extensions or {}\n    dm = ext.get(\"doc_metadata\") or {}\n    env = dm.get(\"envelope\") or {}\n    return str(env.get(\"origin\") or \"\")\n\n\ndef make_hooks(context):\n    store = context.store\n    cache = {\"n\": -1, \"df\": None, \"N\": 0}\n\n    def _df():\n        n = store.count_events()\n        if cache[\"n\"] != n:\n            df = Counter()\n            count = 0\n            for ev in store.live_events():\n                df.update(_toks(_event_text(ev)))\n                count += 1\n            cache[\"n\"], cache[\"df\"], cache[\"N\"] = n, df, count\n        return cache[\"df\"], cache[\"N\"]\n\n    def m6_pack(question, merged):\n        budget = int(question[\"budget\"])\n        qt = _toks(question.get(\"text\") or \"\")\n        df, total = _df()\n\n        def _idf(t):\n            return math.log((total + 1.0) / (df.get(t, 0) + 1.0)) + 1.0\n\n        idf = {t: _idf(t) for t in qt}\n\n        # per item: sentences -> (tokens, overlap, rare, nonfinal) ; keep items with any overlap\n        scored = []\n        for pos, pair in enumerate(merged):\n            ev = pair[1]\n            text = _event_text(ev)\n            toks = _toks(text)\n            if not (qt & toks):\n                continue\n            tool = _origin(ev) in _TOOL_ORIGINS\n            sents = []\n            for s in _SENT.split(text):\n                st = _toks(s)\n                ov = qt & st\n                rare = {t for t in st if t not in qt and not t.isdigit() and len(t) >= 4\n                        and df.get(t, 0) <= RARE_MAX_DF}\n                nonfinal = tool and any(p in s.casefold() for p in _NONFINAL)\n                sents.append((st, ov, rare, nonfinal))\n            scored.append([sents, toks, pos, ev])\n\n        kept, seen, covered, used = [], [], set(), 0\n        hop = {}\n\n        def _value(entry):\n            sents, toks, pos, ev = entry\n            best_s, best_v, total_v = None, -1.0, 0.0\n            for st, ov, rare, nonfinal in sents:\n                v = sum(idf[t] * (COVERED_DISCOUNT if t in covered else 1.0) for t in ov)\n                v += sum(hop[t] for t in st if t in hop)\n                if rare and ov:\n                    v += ANSWER_BONUS\n                if nonfinal:\n                    v *= NONFINAL_FACTOR\n                total_v += v\n                if v > best_v:\n                    best_s, best_v = (st, ov, rare, nonfinal), v\n            return best_v + REST_CREDIT * (total_v - best_v), best_s\n\n        while scored:\n            best, best_val, best_sent = None, -1.0, None\n            for entry in scored:\n                val, sent = _value(entry)\n                if val > best_val or (val == best_val and best is not None and entry[2] < best[2]):\n                    best, best_val, best_sent = entry, val, sent\n            scored.remove(best)\n            sents, toks, pos, ev = best\n            if any(_jaccard(toks, s) >= DUP_JACCARD for s in seen):\n                continue\n            units = context.event_units(ev)\n            if used + units > budget:\n                continue\n            kept.append(context.item_dict(ev, units))\n            seen.append(toks)\n            if best_sent is not None:\n                covered |= best_sent[1]\n                for t in best_sent[2]:               # multi-hop: bridge terms from the matched sentence\n                    if t not in hop:\n                        hop[t] = HOP_WEIGHT * _idf(t)\n            used += units\n        return kept\n\n    dispatch = HookDispatch()\n    dispatch.set_override(abi2.M6, m6_pack)\n    return dispatch"}},"code_roots":{"candidate_isolation_posture":"77e581c35758e0e1bef0b58e07322b7d3f4a7e8c5f120ea7067a48f41cbf0e69","frontier":"9ccdfe9bcabca32015dd5b5a809f1fa4e383500310cd5b18fbafb86dbdbbfea1","generators":"20a8402bc5de5ca791963efd33a31df09ab9cd451e926399a546d8e431d65d15","miner_abi":"074511156e7bb1088596e81dc0794b11221cbd5a35aa875e6a34d9ac28d9f73d","runtime_coretex_memory":"e0e334dba