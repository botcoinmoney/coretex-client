{
  "name": "@botcoinmoney/coretex-client",
  "version": "1.0.0",
  "private": true,
  "description": "Internal TypeScript contract-codec tests; the public CoreTex client is the coretex-validator Python package.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "prebuild": "npm run clean",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run test:unit",
    "test:unit": "npm run build && node --test --test-concurrency=2 --test-reporter=spec ./test/unit/canonical-json.test.mjs ./test/unit/codec.test.mjs ./test/unit/merkle.test.mjs ./test/unit/patch.test.mjs ./test/unit/rig-dispatch.test.mjs ./test/unit/canonical-chain-values.test.mjs ./test/unit/retrieval-decoder.test.mjs ./test/unit/validate.test.mjs"
  },
  "engines": {
    "node": ">=20.10"
  },
  "devDependencies": {
    "@types/node": "^22.19.17",
    "typescript": "^5.6.3"
  }
}
